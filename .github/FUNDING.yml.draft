# Sponsor button configuration for this repository.
#
# Inert by filename: GitHub only recognizes the exact name FUNDING.yml, so
# this file has no effect until it is renamed. Norconex Sponsors is not yet
# approved/active — activating this before that could point the Sponsor
# button at a page that isn't live.
#
# To go live at launch:
#   git mv .github/FUNDING.yml.draft .github/FUNDING.yml

github: Norconex
