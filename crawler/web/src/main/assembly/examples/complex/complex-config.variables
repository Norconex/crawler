# Implicit variable file: same base name as complex-config.xml, so it is
# picked up automatically with no command-line argument.
#
# Keys are matched ignoring case and non-alphanumeric characters, and values
# are taken literally after trimming surrounding spaces.

# startUrl points at a page built only for this example. It links to one
# other example page; the reference filter in complex-config.xml keeps the
# crawl to those two.

profile      = development
crawlerId    = complex-example
workdir      = ./examples-output/complex
startUrl     = https://crawler.norconex.com/examples/complex
crawlDepth   = 1
maxDocuments = 10
numThreads   = 1
