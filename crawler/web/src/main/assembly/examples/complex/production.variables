# Explicit variable file, passed with -variables to override the implicit one:
#
#   crawl-web.sh start -config=./examples/complex/complex-config.xml \
#       -variables=./examples/complex/production.variables
#
# Switching the profile also flips the Velocity conditionals in
# complex-config.xml: slower politeness delay, plus a second committer.
#
# crawlDepth and maxDocuments are raised here to show variable overrides in
# `configrender`; the reference filter still holds the crawl to the two
# example pages, so the run itself collects the same documents either way.

profile      = production
crawlerId    = complex-example-prod
workdir      = ./examples-output/complex-prod
startUrl     = https://crawler.norconex.com/examples/complex
crawlDepth   = 3
maxDocuments = 100
numThreads   = 4
