<!--
  A reusable fragment, pulled into complex-config.xml by a parse directive
  rather than an include directive. That distinction matters: being parsed,
  it is treated as a template in its own right, so the ${siteName} and
  ${fieldsToDelete} variables below resolve from the importer-config.properties
  file sitting beside it. Several crawler configurations can therefore share
  this fragment while each supplies its own values.

  Note the directive names are deliberately spelled out in words here.
  Velocity runs before any XML parsing, so writing one literally inside an
  XML comment would execute it.
  -->
<importer>
  <handlers>

    <!-- Stamp every document with the source it came from. -->
    <handler class="ConstantTransformer">
      <constants>
        <constant name="site">
          <values>
            <value>${siteName|'Unknown site'}</value>
          </values>
        </constant>
      </constants>
    </handler>

    <!-- Drop noisy fields that are of no use downstream. -->
    <handler class="DeleteTransformer">
      <fieldMatcher method="regex" pattern="${fieldsToDelete}"/>
    </handler>

  </handlers>
</importer>
