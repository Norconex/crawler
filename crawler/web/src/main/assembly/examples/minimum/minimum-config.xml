<!--
  The minimum configuration needed to run the Web Crawler, plus a few
  recommended settings.

  One configuration file describes ONE crawler. To run several crawlers,
  give each its own configuration file.

  Run it with:

      crawl-web.sh start -config=./examples/minimum/minimum-config.xml

  Validate it without crawling anything:

      crawl-web.sh configcheck -config=./examples/minimum/minimum-config.xml
  -->
<crawler id="minimum-example">

  <!-- Where the crawler keeps its state between runs. Deleting this
       directory makes the next run treat every document as new. -->
  <workDir>./examples-output/minimum</workDir>

  <!-- Where to start crawling. At least one reference is required.

       This page exists only to be crawled by this example. Once collected,
       its text confirms the run worked and points at what to do next.
       Change this to your own site when you are ready. -->
  <startReferences>
    <ref>https://crawler.norconex.com/examples/minimum</ref>
  </startReferences>

  <!-- Depth 0 fetches the start reference and nothing it links to, so this
       example collects exactly one document. Raise it to follow links. -->
  <maxDepth>0</maxDepth>

  <!-- Off by default the crawler finds the site's sitemap and queues every
       URL in it, which would ignore maxDepth and crawl the whole site.
       Empty elements disable sitemap support; drop them to use sitemaps. -->
  <sitemapResolver/>
  <sitemapLocator/>

  <!-- Where crawled documents go. This one writes XML files to disk, which
       is useful for seeing what was collected; swap it for a committer that
       targets your search engine or database. -->
  <committers>
    <committer class="XmlFileCommitter">
      <directory>./examples-output/minimum/committed</directory>
    </committer>
  </committers>

</crawler>
