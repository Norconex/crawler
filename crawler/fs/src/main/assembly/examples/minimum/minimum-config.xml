<!--
  The minimum configuration needed to run the File System Crawler, plus a
  few recommended settings.

  One configuration file describes ONE crawler. To run several crawlers,
  give each its own configuration file.

  Run it with:

      crawl-fs.sh start -config=./examples/minimum/minimum-config.xml

  Validate it without crawling anything:

      crawl-fs.sh configcheck -config=./examples/minimum/minimum-config.xml
  -->
<crawler id="fs-minimum-example">

  <!-- Where the crawler keeps its state between runs. Deleting this
       directory makes the next run treat every document as new. -->
  <workDir>./examples-output/minimum</workDir>

  <!-- Where to start crawling. At least one reference is required.

       ${user.dir} is the directory the crawler started from, which the
       crawl-fs script sets to the distribution root. So this points at the
       sample folder shipped in the ZIP next to this file. A start reference
       must be an absolute path (or a file:// URL); a bare relative path
       like ./sample-files is not accepted.

       Point it at a folder of your own when you are ready. Forward slashes
       work on Windows too, e.g. C:/data/documents. -->
  <startReferences>
    <ref>${user.dir}/examples/minimum/sample-files</ref>
  </startReferences>

  <!-- For a folder, depth is how many directories down to descend. Depth 1
       collects the files sitting directly in the folder above; raise it to
       walk into sub-folders. -->
  <maxDepth>1</maxDepth>

  <!-- No <fetchers> declared, so the File System Crawler uses its default:
       a LocalFetcher reading the machine's own file systems (including
       mapped and mounted drives). Declare <fetchers> to use FTP, SFTP,
       SMB, S3, and the rest. -->

  <!-- Where crawled documents go. This one writes XML files to disk, which
       is useful for seeing what was collected; swap it for a committer that
       targets your search engine or database. -->
  <committers>
    <committer class="XmlFileCommitter">
      <directory>./examples-output/minimum/committed</directory>
    </committer>
  </committers>

</crawler>
